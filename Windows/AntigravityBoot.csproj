<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Antigravity Boot</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <OutputPath>../build/windows/$(Configuration)/</OutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Management" />
    <None Include="../Media/Presets/gemini-classic.mp4;../Media/Presets/gemini-watercolor.mp4;../Media/Presets/gemini-neon.mp4;../Media/Presets/gemini-switch-team.mp4;../Media/Presets/gemini-stargate.mp4" Link="Media/Presets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../docs/social/douyin.png" Link="Media/douyin.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Media/ANIMATION_NOTICE.md" Link="Media/ANIMATION_NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PackageWindows" DependsOnTargets="Build">
    <MakeDir Directories="../dist" />
    <ZipDirectory SourceDirectory="$(TargetDir)" DestinationFile="../dist/Antigravity-Boot-Windows-x64.zip" Overwrite="true" />
  </Target>
</Project>
